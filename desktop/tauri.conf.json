{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mastermind",
  "version": "0.1.0",
  "identifier": "dev.mastermind.launchcheck",
  "build": {
    "frontendDist": "reviewer-ui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npx vite",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:",
      "capabilities": [
        {
          "identifier": "reviewer",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
